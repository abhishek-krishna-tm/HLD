      "updated": 1794581595544,
      "created": 1794581390874,
      "link": null,
      "locked": false,
      "text": "Types of JWT validation :\n                    \n                        JWT validation        Token introspection\nToken format        Self-contained JWT        Opaque token commonly\nValidation          Locally using trusted keys        Authorization server\nNetwork call/req        Usually no        Often yes\nRevocation          More difficult        Easier to reflect\nLatency             Usually lower        Usually higher",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "dGOjDttZk31KOQfC0z1F6",
      "originalText": "Types of JWT validation :\n                    \n                        JWT validation        Token introspection\nToken format        Self-contained JWT        Opaque token commonly\nValidation          Locally using trusted keys        Authorization server\nNetwork call/req        Usually no        Often yes\nRevocation          More difficult        Easier to reflect\nLatency             Usually lower        Usually higher",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
