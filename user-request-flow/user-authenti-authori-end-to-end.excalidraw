    {
      "id": "v79rqGZHgqrLZ0mP_8dVz",
      "type": "text",
      "x": 1359.6678763383538,
      "y": 1033.946068666329,
      "width": 814,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 40,
      "groupIds": [],
