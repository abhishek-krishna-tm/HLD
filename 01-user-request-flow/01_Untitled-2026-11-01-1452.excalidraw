      "link": null,
      "locked": false,
      "text": "Payment Service\n\n- Gets public Key fm JWKS (JSON Web Key Set)\n-> either from keycloak or cache public keys\nendpoint and verifies if the token is from\nauthentic source.\n- Authorization Check (If passed then make\npayment)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Dle7mJKHs5TMc0OTQfjyA",
      "originalText": "Payment Service\n\n- Gets public Key fm JWKS (JSON Web Key Set) -> either from keycloak or cache public keys endpoint and verifies if the token is from authentic source.\n- Authorization Check (If passed then make payment)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
