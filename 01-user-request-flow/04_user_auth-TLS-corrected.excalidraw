    {
      "id": "7xxAPveKDHvV7p5qUBUDL",
      "type": "text",
      "x": -852.2360527773853,
      "y": 1727.8976843984924,
      "width": 737,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 847280706,
      "version": 637,
      "versionNonce": 846674423,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794749774676,
      "created": 1794611786788,
      "link": null,
      "locked": false,
      "text": "Payment Service\nStep 1 — mTLS -> once per connection\nFirst Verifies Order Service's client certificate. TLS Handshake is\nmade.\nStep 2 — JWT -> every request validation\nValidates the JWT presented with the HTTP request.\nStep 3 — Authorization ->every request validation\nChecks whether this identity can perform this payment operation.\nLets say we are using HTTP/2 and 3 req over same TLS connection\nmTLS Handshake\nRequest 1 — Create payment ₹1,000\nJWT validation\nAuthorization\nRequest 2 — Create payment ₹1,000\nJWT validation\nAuthorization\nRequest 3 — Create payment ₹1,000\nJWT validation\nAuthorization",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "XbS4VoYlm8QCxdxdivZ0p",
      "originalText": "Payment Service\nStep 1 — mTLS -> once per connection\nFirst Verifies Order Service's client certificate. TLS Handshake is made.\nStep 2 — JWT -> every request validation\nValidates the JWT presented with the HTTP request.\nStep 3 — Authorization ->every request validation\nChecks whether this identity can perform this payment operation.\nLets say we are using HTTP/2 and 3 req over same TLS connection\nmTLS Handshake\nRequest 1 — Create payment ₹1,000\nJWT validation\nAuthorization\nRequest 2 — Create payment ₹1,000\nJWT validation\nAuthorization\nRequest 3 — Create payment ₹1,000\nJWT validation\nAuthorization",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
