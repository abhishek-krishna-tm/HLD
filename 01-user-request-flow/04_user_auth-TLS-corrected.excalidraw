    {
      "id": "wzfMKNHIz_NQNLYvIcR2G",
      "type": "text",
      "x": 2340.6190598419294,
      "y": 489.38678409813224,
      "width": 638,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 40,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 532307842,
      "version": 65,
      "versionNonce": 1806394974,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794649888588,
      "created": 1794649225307,
      "link": null,
      "locked": false,
      "text": "Term        Full form        Purpose\nECDHE        Elliptic Curve Diffie–Hellman Ephemeral\nAllows browser and server to establish a shared secret\nsecurely.\nHKDF        HMAC-based Key Derivation Function\nDerives cryptographic keys from shared secret material.\nHMAC        Hash-based Message Authentication Code\nProvides a keyed cryptographic mechanism used internally\nby HKDF.\n\n\nECDHE: Browser and server independently derive the same\nshared secret.\n\nHKDF: Uses that secret and handshake context to derive\nencryption keys.\n\nHMAC: Used internally by HKDF (typically with SHA-256 or\nSHA-384).\n\nAES-GCM / ChaCha20-Poly1305: Uses the derived traffic keys\nto encrypt and authenticate application data.\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "qi9fXTtnUcz1Cu9C0wNqX",
      "originalText": "Term        Full form        Purpose\nECDHE        Elliptic Curve Diffie–Hellman Ephemeral        Allows browser and server to establish a shared secret securely.\nHKDF        HMAC-based Key Derivation Function        Derives cryptographic keys from shared secret material.\nHMAC        Hash-based Message Authentication Code        Provides a keyed cryptographic mechanism used internally by HKDF.\n\n\nECDHE: Browser and server independently derive the same shared secret.\n\nHKDF: Uses that secret and handshake context to derive encryption keys.\n\nHMAC: Used internally by HKDF (typically with SHA-256 or SHA-384).\n\nAES-GCM / ChaCha20-Poly1305: Uses the derived traffic keys to encrypt and authenticate application data.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
